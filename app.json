{
  "expo": {
    "name": "utility_ledger",
    "slug": "utility_ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app/icon.png",
    "scheme": "utilityledger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bogdanpoh.utility-ledger",
      "appleTeamId": "3S8AVD2TKW",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app/android-icon-foreground.png",
        "backgroundImage": "./assets/images/app/android-icon-background.png",
        "monochromeImage": "./assets/images/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bogdanpoh.utilityledger",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/app/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Onest/Onest-Regular.ttf",
              "./assets/fonts/Onest/Onest-Medium.ttf",
              "./assets/fonts/Onest/Onest-SemiBold.ttf",
              "./assets/fonts/Onest/Onest-Bold.ttf",
              "./assets/fonts/Onest/Onest-Black.ttf",
              "./assets/fonts/JetBrainsMono/JetBrainsMono-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Onest",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Onest/Onest-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Onest/Onest-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Onest/Onest-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Onest/Onest-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Onest/Onest-Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono/JetBrainsMono-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosDependencyManager": "spm"
        }
      ],
      "./plugins/with-google-signin-spm-link",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
