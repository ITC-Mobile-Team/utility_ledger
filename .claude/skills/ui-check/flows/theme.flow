# Екран «Тема»: картки зі сценою логотипу без галочки — вибір видно зі стану radio (checked);
# вибір темної перефарбовує застосунок і лишає на екрані, у профілі видно «Темна»;
# наприкінці повертається «Як у системі».
# Потрібен вхід. Запуск з кореня проєкту:
# .claude/skills/ui-check/scripts/ui run .claude/skills/ui-check/flows/theme.flow
launch
tap label=Профіль
wait id=profile.screen
# Розділ «Застосунок» може ховатись під таб-баром (особливо зі статусом «Світла»): прокручуємо до нього
swipe id=profile.screen up distance=0.8
sleep 0.6
# Початковий стан не важливий: спершу вибираємо «Як у системі»
tap id=profile.theme
wait id=theme.screen
tap id=theme.option.system
sleep 0.6
tap id=navigationBar.back
wait id=profile.screen
check id=profile.theme "label~=Як у системі"
tap id=profile.theme
wait id=theme.screen
see Оформлення застосунку
check id=theme.option.system "label~=Як у системі"
check id=theme.option.light label~=Світла
check id=theme.option.dark label~=Темна
check id=theme.option.system "value~=checked"
tap id=theme.option.dark
sleep 0.8
wait id=theme.screen
check id=theme.option.dark "value=radio button, checked"
check id=theme.option.system "value~=unchecked"
shot name=theme-dark scale=0.6
tap id=navigationBar.back
wait id=profile.screen
check id=profile.theme label~=Темна
tap id=profile.theme
wait id=theme.screen
tap id=theme.option.system
sleep 0.6
tap id=navigationBar.back
wait id=profile.screen
check id=profile.theme "label~=Як у системі"
