# Таб «Профіль»: імʼя змінюється через рядок «Імʼя» й видно в профілі, картка профілю не інтерактивна,
# документи відкриваються і закриваються.
# Потрібен вхід. `keys` дописує «2026» до поля імені (цифри не залежать від розкладки HID-клавіатури,
# а `type` у це поле не друкує), але сценарій виходить без збереження, тож імʼя не змінюється.
# Запуск з кореня проєкту: .claude/skills/ui-check/scripts/ui run .claude/skills/ui-check/flows/profile.flow
launch
tap label=Профіль
check role=tab&label=Профіль value=1
wait id=profile.screen
see Спосіб входу
# Картка лише інформує: дотик нічого не відкриває, підпису в рядку «Імʼя» немає
tap id=profile.card
sleep 0.8
check id=profile.screen
gone id=editName.screen
nosee "Як до вас звертатися в застосунку"
see Стартова вкладка
see Тема
tap id=profile.name
wait id=editName.screen
tap id=editName.input
keys 2026
check id=editName.save enabled
# Імʼя не зберігаємо: HID-клавіатура симулятора може зависнути й не прибрати дописане, а збереження
# імені перевірено в специфікації 002. Вихід без збереження лишає імʼя без змін
tap id=navigationBar.back
wait id=profile.screen
nosee 2026
swipe id=profile.screen up distance=0.7
tap id=profile.privacy
wait id=privacy.screen
see 1. Які дані ми збираємо
tap id=navigationBar.back
wait id=profile.screen
swipe id=profile.screen up distance=0.7
tap id=profile.terms
wait id=terms.screen
see 1. Що робить застосунок
tap id=navigationBar.back
check role=tab&label=Профіль value=1

# Статус «Світла» в «Сповіщеннях»: Київ — постачальника немає; кнопка «Налаштувати»
# відкриває налаштування, «Назад» веде на головний екран «Світла»; після вибору
# Полтави й черги 1.1 статус зникає. Сценарій змінює місто «Світла» і наприкінці
# повертає Полтаву з чергою 1.1.
open /outage-settings
wait id=outageSettings.screen
tap id=outageSettings.city
sleep 1
tap label~=Київ
sleep 0.8
tap id=outageSettings.save
sleep 1
tap label=Профіль
wait id=profile.screen
see "Постачальник для вашого міста ще не доданий"
# Після кроків із документами профіль прокручений донизу: повертаємось нагору до кнопки
swipe id=profile.screen down distance=0.9
sleep 0.6
tap id=profile.outageSetup
wait id=outageSettings.screen
tap id=navigationBar.back
check role=tab&label=Світло value=1
tap label=Профіль
wait id=profile.screen
open /outage-settings
wait id=outageSettings.screen
tap id=outageSettings.city
sleep 1
tap "label~=Полтава, Полтаваобленерго"
sleep 0.8
tap id=outageSettings.queue.1.1
tap id=outageSettings.save
sleep 1
tap label=Профіль
wait id=profile.screen
gone id=profile.outageSetup
nosee "Постачальник для вашого міста ще не доданий"
